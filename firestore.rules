rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);

      // Users can create their own profile
      allow create: if isOwner(userId);

      // Users can update their own profile
      allow update: if isOwner(userId);

      // Prevent deletion of user documents
      allow delete: if false;

      // Allow authenticated users to read basic profile info of others
      // (for matching purposes - backend handles filtering sensitive data)
      allow read: if isAuthenticated();
    }

    // Matches collection
    match /matches/{matchId} {
      // Users can read matches they're part of
      allow read: if isAuthenticated() &&
        (resource.data.user1Id == request.auth.uid ||
         resource.data.user2Id == request.auth.uid);

      // Only backend (admin SDK) should create/update matches
      allow write: if false;
    }

    // Conversations collection (AI companion)
    match /conversations/{conversationId} {
      // Users can only access their own conversations
      allow read, write: if isAuthenticated() &&
        conversationId == request.auth.uid;
    }

    // Messages subcollection within conversations
    match /conversations/{conversationId}/messages/{messageId} {
      allow read, write: if isAuthenticated() &&
        conversationId == request.auth.uid;
    }

    // Chat messages between users
    match /chats/{chatId}/messages/{messageId} {
      // Allow read/write if user is part of the chat
      // Chat ID format: sorted(user1Id_user2Id)
      allow read, write: if isAuthenticated() &&
        (chatId.matches('.*' + request.auth.uid + '.*'));
    }
  }
}
